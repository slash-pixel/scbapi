
datasource db {
  provider = "postgresql"
  url      = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Image {
  id        String   @id @default(cuid())
  title     String?
  fileName  String
  url       String
  createdAt DateTime @default(now())
}

model Comment {
  id        Int      @id @default(autoincrement())
  author    String
  content   String
  status    String   @default("pending")
  createdAt DateTime @default(now())
}
